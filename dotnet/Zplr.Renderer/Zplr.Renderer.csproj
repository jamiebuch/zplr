<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Zplr.Renderer</RootNamespace>
    <AssemblyName>Zplr.Renderer</AssemblyName>
    <Version>0.3.0</Version>
    <Authors>zplr</Authors>
    <Description>Port of zplr Node.js renderer — ZPL label parsing and raster rendering for .NET</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>1591;CS1591</NoWarn>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

</Project>
